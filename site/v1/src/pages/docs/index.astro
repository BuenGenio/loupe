---
import Base from '../../layouts/Base.astro';
import DocsSearch from '../../components/DocsSearch.astro';
import Icon from '../../components/Icon.astro';
import { docsBySection } from '../../lib/docs';
import { breadcrumbs } from '../../lib/schema';
import type { IconName } from '../../lib/icons';

const groups = await docsBySection();
const sectionIcon: Record<string, IconName> = {
  'Get started': 'sparkle',
  'Using Loupe': 'mail-inbox',
  'Accounts & security': 'shield-lock',
  Reference: 'book-open',
};
const popular = ['getting-started', 'search-language', 'rules', 'encryption', 'faq'];
const all = groups.flatMap((g) => g.docs);
const quick = popular.map((id) => all.find((d) => d.id === id)).filter((d) => d !== undefined);
---

<Base
  title="Documentation"
  description="Guides for Loupe: install the app, add accounts, search with expressions, build rules, use OpenPGP and S/MIME, and get more from your mail on Android."
  image="/og/docs.jpg"
  jsonLd={[breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Docs', path: '/docs/' }])]}
>
  <section class="top">
    <div class="wrap">
      <p class="eyebrow">Documentation</p>
      <h1>How to get the most out of Loupe</h1>
      <p class="lead">Short, practical guides, from your first account to Sieve rules and S/MIME certificates.</p>
      <div class="search">
        <DocsSearch autofocus />
      </div>
      {
        quick.length > 0 && (
          <p class="quick">
            Popular:{' '}
            {quick.map((d, i) => (
              <>
                {i > 0 && ' · '}
                <a href={`/docs/${d.id}/`}>{d.data.title}</a>
              </>
            ))}
          </p>
        )
      }
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap sections">
      {
        groups.map((g) => (
          <section class="card group" aria-labelledby={`s-${g.section}`}>
            <div class="head">
              <div class="icon-tile">
                <Icon name={sectionIcon[g.section] ?? 'document-text'} />
              </div>
              <h2 id={`s-${g.section}`}>{g.section}</h2>
            </div>
            <ul>
              {g.docs.map((d) => (
                <li>
                  <a href={`/docs/${d.id}/`}>
                    <strong>{d.data.title}</strong>
                    <span>{d.data.description}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .top {
    padding-block: clamp(48px, 7vw, 88px) 16px;
  }

  h1 {
    max-width: 16em;
    font-size: clamp(2.4rem, 5.5vw, 3.6rem);
  }

  .search {
    max-width: 560px;
    margin-top: 28px;
  }

  .quick {
    margin-top: 14px;
    color: var(--ink-3);
    font-size: 0.9375rem;
  }

  .sections {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    align-items: start;
  }

  .group {
    padding: 24px;
  }

  .head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 12px;
  }

  .head h2 {
    margin: 0;
    font-size: 1.5rem;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li a {
    display: grid;
    gap: 2px;
    padding: 12px;
    margin-inline: -12px;
    border-radius: 12px;
    color: var(--ink);
    text-decoration: none;
  }

  li a:hover {
    background: var(--bg-sunk);
  }

  li strong {
    font-weight: 500;
  }

  li span {
    color: var(--ink-2);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  @media (max-width: 820px) {
    .sections {
      grid-template-columns: 1fr;
    }
  }
</style>
