---
// One timeline, newest first: a release for every dated section of the repo's
// CHANGELOG.md, with its bullets inline, and an article for every post in
// src/content/articles/, linking to its own page.
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { feed, formatDate, readingTime } from '../../lib/news';
import { breadcrumbs } from '../../lib/schema';

const rows = await Promise.all(
  (await feed()).map(async (item) => (item.kind === 'release' ? { ...item, Body: (await render(item.entry)).Content } : item)),
);
---

<Base
  title="News"
  description="What's new in Loupe: every release with its notes, newest first, plus longer pieces on how a private, open-source mail app for Android is built."
  image="/og/news.jpg"
  jsonLd={[
    { '@type': 'Blog', name: 'Loupe news', url: 'https://loupe.mx/news/' },
    breadcrumbs([{ name: 'Home', path: '/' }, { name: 'News', path: '/news/' }]),
  ]}
>
  <section class="top">
    <div class="wrap">
      <p class="eyebrow"><Icon name="news" size={16} /> News</p>
      <h1>What's new in Loupe</h1>
      <p class="lead">
        Every release and its notes, newest first, with the occasional longer read. <a href="/rss.xml">RSS feed</a>
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      {
        rows.length === 0 ? (
          <p class="muted">The first release is on its way.</p>
        ) : (
          <ol class="feed">
            {rows.map((row) =>
              row.kind === 'release' ? (
                <li class="item release">
                  <article class="card" id={row.entry.id}>
                    <p class="kind">Release</p>
                    <h2>
                      <a href={`#${row.entry.id}`}>
                        <time datetime={row.date.toISOString()}>{formatDate(row.date)}</time>
                      </a>
                    </h2>
                    <div class="prose notes">
                      <row.Body />
                    </div>
                  </article>
                </li>
              ) : (
                <li class="item article">
                  <article class="card">
                    <p class="kind">
                      Article <span aria-hidden="true">·</span>{' '}
                      <time datetime={row.date.toISOString()}>{formatDate(row.date)}</time> <span aria-hidden="true">·</span> {readingTime(row.entry.body)} min read
                    </p>
                    <h2><a href={`/news/${row.entry.id}/`}>{row.entry.data.title}</a></h2>
                    <p class="standfirst">{row.entry.data.description}</p>
                    <a class="more" href={`/news/${row.entry.id}/`}>
                      Read <Icon name="arrow-right" size={16} />
                    </a>
                  </article>
                </li>
              ),
            )}
          </ol>
        )
      }
    </div>
  </section>
</Base>

<style>
  /* News is a reading column: the heading and the feed share one width,
     centred, rather than hugging the left of the site's wider wrap. */
  .wrap {
    --wrap: 820px;
  }

  .top {
    padding-block: clamp(48px, 7vw, 88px) 8px;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
  }

  .lead {
    max-width: 44ch;
  }

  /* The timeline: one line down the left, a dot per entry. */
  .feed {
    position: relative;
    margin: 0;
    padding: 0 0 0 34px;
    list-style: none;
  }

  .feed::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 28px;
    bottom: 28px;
    width: 2px;
    background: var(--line);
  }

  .item {
    position: relative;
  }

  .item + .item {
    margin-top: 20px;
  }

  .item::before {
    content: '';
    position: absolute;
    left: -34px;
    top: 26px;
    width: 16px;
    height: 16px;
    border: 3px solid var(--bg);
    border-radius: 999px;
    background: var(--line-2);
  }

  .item.article::before {
    background: var(--brand);
  }

  .card {
    padding: clamp(20px, 3vw, 30px);
  }

  /* Articles are the rare entry, so they carry the tint; releases stay calm. */
  .article .card {
    background: var(--brand-soft);
    border-color: var(--brand-soft);
  }

  .kind {
    margin: 0 0 6px;
    color: var(--ink-3);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .article .kind {
    color: var(--brand-ink);
    text-transform: none;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.375rem, 2.6vw, 1.625rem);
  }

  h2 a {
    color: inherit;
    text-decoration: none;
  }

  h2 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .notes {
    max-width: 68ch;
    margin-top: 12px;
  }

  .notes :global(ul) {
    margin-bottom: 0;
    /* The feed is an <ol>, which would otherwise make these bullets hollow. */
    list-style-type: disc;
  }

  .notes :global(li) {
    margin: 0.45em 0;
  }

  .notes :global(p) {
    margin: 0 0 0.8em;
    color: var(--ink-2);
  }

  .standfirst {
    margin: 8px 0 14px;
    max-width: 62ch;
    color: var(--ink-2);
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--brand-ink);
    font-weight: 500;
    text-decoration: none;
  }

  .more:hover {
    text-decoration: underline;
  }

  @media (max-width: 560px) {
    .feed {
      padding-left: 26px;
    }

    .feed::before {
      left: 5px;
    }

    .item::before {
      left: -26px;
      width: 12px;
      height: 12px;
      top: 24px;
      border-width: 2px;
    }
  }
</style>
