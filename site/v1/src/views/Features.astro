---
import Base from '../layouts/Base.astro';
import Device from '../components/Device.astro';
import Icon from '../components/Icon.astro';
import SearchPlayground from '../components/SearchPlayground.astro';
import { useT, localize } from '../i18n';
import { extras, groups, highlights } from '../lib/features';
import { shotFor } from '../lib/screenshots';
import { breadcrumbs, softwareApplication } from '../lib/schema';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = useT(lang);
const l = (path: string) => localize(lang, path);
const more = highlights.filter((h) => extras.includes(h.key));

// The chips, in order. Each one shows its panel below in place of the last;
// without JavaScript they are plain links and every panel shows in turn.
const tabs = [
  { id: 'rule', label: t('features.principleEyebrow') },
  ...groups.map((g) => ({ id: g.id, label: t(`groups.${g.id}.eyebrow`) })),
  { id: 'protocols', label: t('features.jmapEyebrow') },
  { id: 'more', label: t('features.andMore') },
];

// Panels with a second view, "under the hood", opened by a button named after
// that view's own title (so no new strings to translate).
const deeper: Record<string, string> = {
  reading: t('features.rpTitle'),
  search: t('features.seTitle'),
  security: t('features.securityDetails'),
};
---

<Base
  lang={lang}
  title={t('features.title')}
  description={t('features.description')}
  image={lang === 'en' ? '/og/features.jpg' : `/og/${lang}/features.jpg`}
  jsonLd={[softwareApplication(), breadcrumbs([{ name: 'Loupe', path: l('/') }, { name: t('features.title'), path: l('/features/') }])]}
>
  <section class="top">
    <div class="wrap">
      <p class="eyebrow">{t('features.eyebrow')}</p>
      <h1>
        {t('features.h1_html')
          .split(/<br\s*\/?>/)
          .map((part, i) => (
            <>
              {i > 0 && ' '}
              <span class="line" set:html={part} />
            </>
          ))}
      </h1>
      <p class="lead">{t('features.lead')}</p>
    </div>
  </section>

  <!-- Before the sections: take the #tab off the address so the browser
       doesn't scroll down to that section while loading; the tabs script
       below picks the tab and puts the hash back. -->
  <script is:inline>
    if (location.hash.length > 1) {
      window.loupeFeaturesTab = location.hash.slice(1);
      history.replaceState(history.state, '', location.pathname + location.search);
    }
  </script>

  <div class="explorer" id="explorer">
    <div class="tabs-bar">
      <div class="wrap">
        <nav class="jump" aria-label={t('features.jump')}>
          {tabs.map((tab) => <a class="chip" href={`#${tab.id}`} data-tab={tab.id}>{tab.label}</a>)}
        </nav>
      </div>
    </div>

    <section id="rule" class="panel principle" data-panel aria-labelledby="principle-title">
      <div class="wrap principle-grid">
        <div>
          <p class="eyebrow panel-eyebrow">{t('features.principleEyebrow')}</p>
          <h2 id="principle-title">{t('features.principleTitle')}</h2>
          <p class="lead">{t('features.principleLead')}</p>
        </div>
        <ol class="places">
          {(['press-and-hold', 'more', 'search', 'settings'] as const).map((_, n) => (
            <li>
              <span class="num" aria-hidden="true">{n + 1}</span>
              <div>
                <strong>{t(`features.place${n + 1}`)}</strong>
                <span>{t(`features.place${n + 1}Text`)}</span>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {
      groups.map((g) => (
        <section id={g.id} class="panel group" data-panel aria-labelledby={`${g.id}-title`}>
          <div class="view" data-view="main">
            <div class="wrap group-grid">
              <div class="copy">
                <p class="eyebrow panel-eyebrow">{t(`groups.${g.id}.eyebrow`)}</p>
                <h2 id={`${g.id}-title`}>{t(`groups.${g.id}.title`)}</h2>
                <p class="lead">{t(`groups.${g.id}.lead`)}</p>
                <ul class="points">
                  {g.icons.map((icon, n) => (
                    <li>
                      <div class="icon-tile">
                        <Icon name={icon} />
                      </div>
                      <div>
                        <h3>{t(`groups.${g.id}.p${n + 1}.title`)}</h3>
                        <p>{t(`groups.${g.id}.p${n + 1}.text`)}</p>
                      </div>
                    </li>
                  ))}
                </ul>
                {deeper[g.id] && (
                  <button type="button" class="deeper" data-show="deep">
                    {deeper[g.id]} <Icon name="arrow-right" size={18} />
                  </button>
                )}
              </div>
              <div class="visual">
                {g.id === 'search' ? (
                  <SearchPlayground lang={lang} />
                ) : (
                  <Device shot={shotFor(g.shot)} placeholder={t('common.screenshotSoon')} />
                )}
              </div>
            </div>
          </div>

          {g.id === 'reading' && (
            <div class="view deep" data-view="deep">
              <div class="wrap">
                <button type="button" class="back" data-show="main">
                  <Icon name="arrow-left" size={18} /> {t(`groups.${g.id}.eyebrow`)}
                </button>
                <div class="section-head">
                  <p class="eyebrow">{t('features.rpEyebrow')}</p>
                  <h2 id="rp-title">{t('features.rpTitle')}</h2>
                  <p class="lead">{t('features.rpLead')}</p>
                </div>
                <ol class="steps">
                  {[1, 2, 3, 4, 5, 6].map((n) => (
                    <li class="card">
                      <span class="step" aria-hidden="true">{n}</span>
                      <h3>{t(`features.rp${n}`)}</h3>
                      <p>{t(`features.rp${n}Text`)}</p>
                    </li>
                  ))}
                </ol>
              </div>
            </div>
          )}

          {g.id === 'search' && (
            <div class="view deep" data-view="deep">
              <div class="wrap">
                <button type="button" class="back" data-show="main">
                  <Icon name="arrow-left" size={18} /> {t(`groups.${g.id}.eyebrow`)}
                </button>
                <div class="section-head">
                  <p class="eyebrow">{t('features.rpEyebrow')}</p>
                  <h2 id="se-title">{t('features.seTitle')}</h2>
                  <p class="lead">{t('features.seLead')}</p>
                </div>
                <div class="engines">
                  {(['Local', 'Imap', 'Gmail', 'Jmap'] as const).map((k) => (
                    <div class="engine">
                      <h3>{t(`features.se${k}`)}</h3>
                      <p>{t(`features.se${k}Text`)}</p>
                    </div>
                  ))}
                </div>
                <p class="engine-note">
                  <Icon name="filter" size={18} /> <span>{t('features.seNote')}</span>
                </p>
              </div>
            </div>
          )}

          {g.id === 'security' && (
            <div class="view deep" data-view="deep">
              <div class="wrap">
                <button type="button" class="back" data-show="main">
                  <Icon name="arrow-left" size={18} /> {t(`groups.${g.id}.eyebrow`)}
                </button>
                <div class="details">
                  <h3>{t('features.securityDetails')}</h3>
                  <ul>
                    {[1, 2, 3, 4].map((n) => (
                      <li>
                        <Icon name="checkmark" size={16} /> {t(`features.sec${n}`)}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          )}
        </section>
      ))
    }

    <section id="protocols" class="panel jmap" data-panel aria-labelledby="jmap-title">
      <div class="wrap jmap-grid">
        <div>
          <p class="eyebrow panel-eyebrow">{t('features.jmapEyebrow')}</p>
          <h2 id="jmap-title">{t('features.jmapTitle')}</h2>
          <p class="lead">{t('features.jmapLead')}</p>
        </div>
        <ul class="jmap-list">
          {[1, 2, 3, 4].map((n) => (
            <li>
              <strong>{t(`features.jmap${n}`)}</strong>
              <span>{t(`features.jmap${n}Text`)}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="more" class="panel more-panel" data-panel aria-labelledby="more-title">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow panel-eyebrow">{t('features.andMore')}</p>
          <h2 id="more-title">{t('features.moreTitle')}</h2>
        </div>
        <div class="more-grid">
          {
            more.map((f) => (
              <a class="card more" href={f.docs}>
                <div class="icon-tile">
                  <Icon name={f.icon} />
                </div>
                <h3>{t(`highlights.${f.key}.title`)}</h3>
                <p>{t(`highlights.${f.key}.text`)}</p>
                <span class="go">
                  {t('common.readGuide')} <Icon name="arrow-right" size={16} />
                </span>
              </a>
            ))
          }
        </div>
        <div class="end">
          <a class="btn btn-primary" href={l('/download/')}><Icon name="arrow-download" size={20} /> {t('common.downloadLoupe')}</a>
          <a class="btn" href={l('/screenshots/')}>{t('common.seeAllScreenshots')}</a>
        </div>
      </div>
    </section>
  </div>

  <!-- Inline, right after the markup, so only one panel is ever painted. -->
  <script is:inline>
    (() => {
      const root = document.getElementById('explorer');
      const nav = root && root.querySelector('.jump');
      if (!nav) return;
      const bar = root.querySelector('.tabs-bar');
      const tabs = [...nav.querySelectorAll('[data-tab]')];
      const panels = new Map([...root.querySelectorAll('[data-panel]')].map((p) => [p.id, p]));
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let current = null;

      root.classList.add('tabs-ready');
      nav.setAttribute('role', 'tablist');
      for (const tab of tabs) {
        const panel = panels.get(tab.dataset.tab);
        // Renamed so the browser finds nothing to scroll to for /features/#search;
        // the hash picks the tab instead.
        panel.id = `panel-${tab.dataset.tab}`;
        tab.id = `tab-${tab.dataset.tab}`;
        tab.setAttribute('role', 'tab');
        tab.setAttribute('aria-controls', panel.id);
        panel.setAttribute('role', 'tabpanel');
        panel.setAttribute('aria-labelledby', tab.id);
      }

      // Fades in what the reader just picked (never on the first paint).
      function fade(el) {
        if (still) return;
        el.classList.remove('fade');
        void el.offsetWidth;
        el.classList.add('fade');
      }

      function show(panel, name, animate = false) {
        for (const view of panel.querySelectorAll('[data-view]')) {
          const on = view.dataset.view === name;
          view.hidden = !on;
          if (on && animate) fade(view);
        }
      }

      function select(id, { focus = false, animate = true } = {}) {
        current = id;
        for (const tab of tabs) {
          const on = tab.dataset.tab === id;
          tab.setAttribute('aria-selected', String(on));
          tab.tabIndex = on ? 0 : -1;
          if (!on) continue;
          if (focus) tab.focus({ preventScroll: true });
          // On a phone the chips scroll sideways: bring this one to the middle.
          const left = tab.offsetLeft - (nav.clientWidth - tab.offsetWidth) / 2;
          nav.scrollTo({ left: Math.max(0, left), behavior: animate && !still ? 'smooth' : 'auto' });
        }
        for (const [pid, panel] of panels) {
          const on = pid === id;
          panel.hidden = !on;
          if (!on) continue;
          show(panel, 'main');
          if (animate) fade(panel);
        }
      }

      // If the reader has scrolled down a long panel (on a phone), start the new
      // one just under the chips instead of somewhere in its middle.
      function settle() {
        const top = panels.get(current).getBoundingClientRect().top;
        const under = bar.getBoundingClientRect().bottom;
        if (top < under - 1) window.scrollBy(0, top - under);
      }

      const known = (hash) => {
        try {
          const id = decodeURIComponent(hash || '');
          return panels.has(id) ? id : null;
        } catch {
          return null; // a malformed hash such as #%E0
        }
      };
      const fromHash = () => known(location.hash.slice(1));
      const early = window.loupeFeaturesTab;
      const linked = known(early);
      select(linked || tabs[0].dataset.tab, { animate: false });
      // Put back the hash the script above took off (any hash, tab or not).
      if (early) history.replaceState(history.state, '', `#${early}`);

      nav.addEventListener('click', (e) => {
        const tab = e.target.closest('[data-tab]');
        if (!tab) return;
        e.preventDefault();
        select(tab.dataset.tab);
        history.replaceState(null, '', `#${tab.dataset.tab}`);
        settle();
      });

      nav.addEventListener('keydown', (e) => {
        const i = tabs.indexOf(document.activeElement);
        const to = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 }[e.key];
        if (i < 0 || to === undefined) return;
        e.preventDefault();
        const tab = tabs[(to + tabs.length) % tabs.length];
        select(tab.dataset.tab, { focus: true });
        history.replaceState(null, '', `#${tab.dataset.tab}`);
      });

      root.addEventListener('click', (e) => {
        const button = e.target.closest('[data-show]');
        if (!button) return;
        const panel = button.closest('[data-panel]');
        show(panel, button.dataset.show, true);
        panel.querySelector(`[data-view="${button.dataset.show}"] [data-show]`)?.focus({ preventScroll: true });
        settle();
      });

      addEventListener('hashchange', () => {
        const id = fromHash();
        if (id && id !== current) {
          select(id);
          settle();
        }
      });
    })();
  </script>
</Base>

<style>
  .top {
    padding-block: clamp(40px, 6vw, 80px) clamp(16px, 3vw, 28px);
  }

  h1 {
    max-width: 14em;
    font-size: clamp(2.3rem, 6vw, 4rem);
  }

  .line {
    display: block;
  }

  .top .lead {
    max-width: 38em;
  }

  /* The chips: links to the sections, or tabs once the script has run. They
     stay under the header while a long panel scrolls on a phone. */
  .tabs-bar {
    position: sticky;
    top: var(--header-h);
    z-index: 20;
    padding-block: 12px;
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }

  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .jump a {
    min-height: 40px;
    padding: 6px 16px;
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .jump a:hover {
    border-color: var(--brand);
    color: var(--brand-ink);
  }

  .jump a[aria-selected='true'] {
    border-color: var(--brand);
    background: var(--brand);
    color: var(--bg-elev);
  }

  .panel {
    padding-block: clamp(32px, 5vw, 64px);
    background: var(--bg-elev);
  }

  /* Without the script every panel shows, one after the other. */
  .panel + .panel {
    border-top: 1px solid var(--line);
  }

  .tabs-ready [hidden] {
    display: none !important;
  }

  .tabs-ready .panel-eyebrow {
    display: none;
  }

  .tabs-ready .fade {
    animation: fade-in 0.32s ease both;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }


  .deeper,
  .back {
    display: none;
  }

  .tabs-ready .deeper,
  .tabs-ready .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--brand-ink);
    font: inherit;
    font-weight: 500;
    cursor: pointer;
  }

  .deeper {
    margin-top: 20px;
  }

  .back {
    margin-bottom: 12px;
  }

  .deeper:hover,
  .back:hover {
    text-decoration: underline;
  }

  .principle-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 72px);
    align-items: center;
  }

  .principle h2,
  .deep h2,
  .jmap h2,
  .more-panel h2 {
    font-size: clamp(2rem, 4vw, 2.8rem);
  }

  .places {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .places li {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 16px 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
  }

  .num {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--brand-soft);
    color: var(--brand-ink);
    font-weight: 500;
  }

  .places strong {
    display: block;
    font-weight: 500;
  }

  .places span {
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .deep {
    margin-top: clamp(40px, 6vw, 72px);
    padding-top: clamp(40px, 6vw, 72px);
    border-top: 1px solid var(--line);
  }

  .tabs-ready .deep {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    padding: 20px 22px;
  }

  .step {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 9px;
    background: var(--navy);
    color: #e6f6f8;
    font-weight: 500;
    font-size: 0.9375rem;
  }

  .steps h3,
  .engine h3 {
    margin: 12px 0 6px;
    font-size: 1.0625rem;
    font-weight: 500;
  }

  .steps p,
  .engine p {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .engines {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    overflow: hidden;
    background: var(--bg);
  }

  .engine {
    padding: 22px 24px;
    border-right: 1px solid var(--line);
  }

  .engine:last-child {
    border-right: 0;
  }

  .engine h3 {
    margin-top: 0;
    color: var(--brand-ink);
  }

  .engine-note {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    max-width: 72ch;
    margin: 20px 0 0;
    color: var(--ink-2);
  }

  .engine-note :global(svg) {
    flex: none;
    margin-top: 4px;
    color: var(--brand);
  }

  .details {
    max-width: 760px;
    padding: 24px 26px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
  }

  .details h3 {
    margin: 0 0 14px;
    font-size: clamp(1.4rem, 2.4vw, 1.8rem);
    font-weight: 500;
  }

  .details ul {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--ink-2);
  }

  .details li {
    display: flex;
    gap: 10px;
  }

  .details :global(svg) {
    flex: none;
    margin-top: 5px;
    color: var(--ok);
  }

  .jmap {
    background:
      radial-gradient(700px 360px at 100% 0%, rgb(67 195 205 / 18%), transparent 70%),
      linear-gradient(160deg, var(--navy), var(--navy-2));
    color: #e6eef5;
  }

  .jmap .eyebrow {
    color: #74d8e0;
  }

  .jmap h2 {
    color: #fff;
  }

  .jmap .lead {
    color: #b4c3d1;
  }

  .jmap-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 72px);
    align-items: center;
  }

  .jmap-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .jmap-list li {
    display: grid;
    gap: 4px;
    padding: 18px 20px;
    border: 1px solid rgb(255 255 255 / 10%);
    border-radius: var(--radius);
    background: rgb(255 255 255 / 4%);
  }

  .jmap-list strong {
    color: #fff;
    font-weight: 500;
  }

  .jmap-list span {
    color: #b4c3d1;
    font-size: 0.9375rem;
  }

  .group-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: center;
    gap: clamp(32px, 5vw, 72px);
  }

  .group h2 {
    font-size: clamp(2rem, 4vw, 2.9rem);
  }

  .points {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px 28px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .points li {
    display: flex;
    gap: 14px;
  }

  .points .icon-tile {
    flex: none;
    width: 40px;
    height: 40px;
  }

  .points h3 {
    margin: 2px 0 4px;
    font-size: 1rem;
  }

  .points p {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .visual {
    display: grid;
    justify-items: center;
    min-width: 0;
  }

  .visual :global(.device) {
    max-width: 320px;
  }

  .visual :global(.playground) {
    width: 100%;
  }

  .more-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .more {
    display: flex;
    flex-direction: column;
    padding: 24px;
    color: inherit;
    text-decoration: none;
  }

  .more:hover {
    border-color: var(--brand);
  }

  .more h3 {
    margin: 16px 0 6px;
    font-size: 1.0625rem;
  }

  .more p {
    flex: 1;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .go {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--brand-ink);
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .end {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 40px;
  }

  /* A laptop or desktop: the title, the chips and one whole panel in one
     screen. The headline goes on one line, and the phone is sized by the
     height that's left (1170 × 2532 screenshots). */
