# Cloudflare static-asset headers (Workers assets and Pages read this file).
# The Matomo host (src/config.ts → site.matomo) is allowed in script-src, img-src and connect-src.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://matomo.matumi.anthill.hk; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://matomo.matumi.anthill.hk; font-src 'self'; connect-src 'self' https://cloudflareinsights.com https://matomo.matumi.anthill.hk; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/og/*
  Cache-Control: public, max-age=86400

/icon-*
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/flags/*
  Cache-Control: public, max-age=604800
