---
// A concept screen for the planned natural-language search. Its parent labels
// it as coming soon and supplies the same Device frame as the real screenshots.
// New AI copy is English only, like lib/private-ai.ts, until the feature ships.
import Icon from './Icon.astro';
import { useT } from '../i18n';
import { mailbox, tagColours } from '../lib/demo-mailbox';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useT(lang);
const d = (key: string) => t(`searchDemo.${key}`);
const expression = 'f:(dana or ben) -is:read';
const results = mailbox.filter((message) => message.unread && ['Dana Okafor', 'Ben Walsh'].includes(message.from));
const count = t(`searchPlay.results_${new Intl.PluralRules(lang).select(results.length)}`).replace('{n}', String(results.length));
const cap = (value: string) => value.charAt(0).toLocaleUpperCase(lang) + value.slice(1);
const time = new Intl.DateTimeFormat(lang, { hour: 'numeric', minute: '2-digit' });
const when = (message: (typeof mailbox)[number]) => {
  if (message.daysAgo === 1) return cap(d('yesterday'));
  const [hours, minutes] = message.time.split(':').map(Number);
  return time.format(new Date(2026, 9, 29, hours, minutes));
};
---

<div class="ai-search-screen" lang={lang}>
  <div class="app-bar">
    <span class="back" aria-hidden="true"><Icon name="arrow-left" /></span>
    <strong>{t('screenshots.feature.search')}</strong>
    <span class="search-icon" aria-hidden="true"><Icon name="search" /></span>
  </div>

  <div class="query-area">
    <div class="query" lang="en">
      <span class="query-icon"><Icon name="search-sparkle" /></span>
      <span>Unread mail from Dana or Ben</span>
    </div>
    <div class="provider" lang="en">
      <span class="ai-label"><Icon name="sparkle" /> Private AI</span>
      <span class="on-phone"><Icon name="lock-closed" /> On this phone</span>
    </div>
    <ul class="filters" aria-label={d('readsAs')}>
      <li><span>{d('from')}:</span> <span lang="en">Dana or Ben</span></li>
      <li>{cap(d('unread'))}</li>
    </ul>
    <details class="expression" lang="en">
      <summary>Show expression</summary>
      <code>{expression}</code>
    </details>
  </div>

  <div class="results-heading"><strong>{count}</strong><span aria-hidden="true">···</span></div>
  <ol class="messages">
    {results.map((message) => (
      <li class="message">
        <div class="markers" aria-label={d('unread')}>
          <span class="unread" />
          {message.flagged && <span class="flag" title={d('flagged')} />}
        </div>
        <div class="message-copy">
          <div class="message-top">
            <strong class="sender" lang="en">{message.from}</strong>
            <span class="time">{when(message)}</span>
          </div>
          <div class="subject-line">
            <strong lang="en">{message.subject}</strong>
            <span class="tags" aria-hidden="true">
              {message.tags.map((tag) => <span style={`--tag-colour:${tagColours[tag] ?? '#7a8a99'}`} />)}
            </span>
          </div>
          <p class="snippet" lang="en">{message.body}</p>
          <div class="message-foot">
            <span lang="en">Inbox · Work</span>
            {message.attachments.length > 0 && <span class="attachment"><Icon name="document-text" label={d('hasAttachment')} /></span>}
          </div>
        </div>
      </li>
    ))}
  </ol>
  <div class="screen-bottom" aria-hidden="true"><span /></div>
</div>

<style>
  .ai-search-screen {
    --search-blue: #087bff;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    overflow: hidden;
    container-type: inline-size;
    background: var(--bg-elev);
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-weight: 400;
    line-height: 1.35;
    text-align: left;
  }

  .app-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    gap: 3cqw;
    padding: 7cqw 5cqw 3cqw;
    color: var(--search-blue);
    font-size: 5cqw;
  }

  .app-bar strong { color: var(--ink); font-weight: 600; }
  .app-bar :global(svg) { width: 5.8cqw; height: 5.8cqw; }
  .query-area { flex-shrink: 0; padding: 0 4cqw; }

  .query {
    display: flex;
    align-items: center;
    gap: 2.5cqw;
    min-height: 17cqw;
    padding: 3.5cqw;
    border-radius: 3.5cqw;
    background: var(--bg-sunk);
    font-size: 4.9cqw;
    font-weight: 400;
    line-height: 1.35;
  }

  .query-icon { flex-shrink: 0; color: var(--search-blue); }
  .query-icon :global(svg) { width: 6cqw; height: 6cqw; }
  .provider { display: flex; align-items: center; justify-content: space-between; gap: 2cqw; padding: 2.8cqw 0; font-size: 3.2cqw; }
  .ai-label, .on-phone { display: inline-flex; align-items: center; gap: 1.2cqw; }
  .ai-label { color: var(--brand-ink); font-weight: 600; }
  .on-phone { color: var(--ink-3); }
  .provider :global(svg) { width: 3.8cqw; height: 3.8cqw; }
  .filters { display: flex; flex-wrap: wrap; gap: 2cqw; margin: 0; padding: 0; list-style: none; font-size: 3.6cqw; }
  .filters li { padding: 2cqw 3cqw; border-radius: 8cqw; background: var(--glass); color: var(--search-blue); font-weight: 600; }
  .filters li > span:first-child { font-weight: 400; }
  .expression { margin-top: 2.8cqw; color: var(--ink-2); font-size: 3.4cqw; }
  .expression summary { width: fit-content; padding-block: 1.2cqw; cursor: pointer; color: var(--search-blue); }
  .expression code { display: block; margin-top: 1cqw; padding: 2.5cqw; border-radius: 2cqw; background: var(--bg-sunk); color: var(--ink); font-size: 3.5cqw; overflow-wrap: anywhere; }
  .results-heading { display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; padding: 3cqw 4cqw 2cqw; font-size: 4.5cqw; }
  .results-heading strong { font-weight: 650; }
  .results-heading > span { color: var(--search-blue); font-size: 6cqw; line-height: 1; letter-spacing: .3cqw; }
  .messages { margin: 0; padding: 0; list-style: none; }
  .message { display: flex; gap: 2.4cqw; padding: 2.6cqw 4cqw 2.6cqw 2.3cqw; }
  .markers { display: flex; flex: 0 0 2cqw; flex-direction: column; align-items: center; gap: 1.8cqw; padding-top: 1.7cqw; }
  .unread { display: block; width: 2cqw; height: 2cqw; border-radius: 50%; background: var(--search-blue); }
  .flag { display: block; width: 2cqw; height: 2.6cqw; border-left: .5cqw solid #f79000; background: #f79000; clip-path: polygon(0 0, 100% 0, 72% 40%, 100% 76%, 25% 76%, 25% 100%, 0 100%); }
  .message-copy { flex: 1; min-width: 0; }
  .message + .message { position: relative; }
  .message + .message::before { position: absolute; top: 0; left: 6.7cqw; right: 0; height: 1px; background: var(--line); content: ''; }
  .message-top { display: flex; align-items: baseline; justify-content: space-between; gap: 2cqw; }
  .sender { font-size: 4.4cqw; font-weight: 650; }
  .time { flex-shrink: 0; color: var(--ink-3); font-size: 3.35cqw; }
  .subject-line { display: flex; align-items: center; gap: 1.6cqw; margin-top: 1cqw; font-size: 3.8cqw; line-height: 1.4; }
  .subject-line strong { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; }
  .tags { display: flex; flex-shrink: 0; gap: 1cqw; }
  .tags > span { width: 1.6cqw; height: 1.6cqw; border-radius: 50%; background: var(--tag-colour); }
  .snippet { display: -webkit-box; overflow: hidden; margin: 1cqw 0 0; color: var(--ink-3); font-size: 3.7cqw; line-height: 1.4; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  .message-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 1.3cqw; color: var(--ink-3); font-size: 3.1cqw; }
  .attachment :global(svg) { width: 3.4cqw; height: 3.4cqw; }
  .screen-bottom { display: flex; align-items: end; justify-content: center; flex: 1; min-height: 6cqw; padding-block: 3cqw 2.5cqw; }
  .screen-bottom > span { width: 28cqw; height: 1.2cqw; border-radius: 2cqw; background: var(--ink); opacity: .8; }
</style>
