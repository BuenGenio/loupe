---
// A Fluent UI System Icon, inlined. Decorative unless `label` is given.
import { icons, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
}
const { name, size = 24, label, class: className } = Astro.props;
const svg = icons[name]
  .replace(/ width="24" height="24"/, ` width="${size}" height="${size}"`)
  .replace(
    '<svg ',
    `<svg fill="currentColor" ${label ? `role="img" aria-label="${label}"` : 'aria-hidden="true" focusable="false"'} ${className ? `class="${className}"` : ''} `,
  );
---

<Fragment set:html={svg} />
