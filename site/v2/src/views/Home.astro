---
import Base from '../layouts/Base.astro';
import Device from '../components/Device.astro';
import Icon from '../components/Icon.astro';
import SearchPlayground from '../components/SearchPlayground.astro';
import AiDemo from '../components/AiDemo.astro';
import { site } from '../config';
import { useT, localize } from '../i18n';
import { highlights, providers } from '../lib/features';
import { screenshots, shot, shotFor } from '../lib/screenshots';
import { softwareApplication, sourceCode } from '../lib/schema';
import { stats, roughly } from '../lib/stats';
import { aiFeatures, intro as aiIntro, principles as aiPrinciples, soonLabel } from '../lib/private-ai';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = useT(lang);
const l = (path: string) => localize(lang, path);
const og = lang === 'en' ? '/og/home.jpg' : `/og/${lang}/home.jpg`;

const hero = shot('search-hero', 'search', 'inbox') ?? screenshots.find((s) => s.device === 'phone');
// The hero's screenshot strip: every phone screen, the lens shot first (it
// replaces the plain search shot), filtered by the chips in the card header.
const strip = [hero, ...screenshots.filter((x) => x.device === 'phone' && x !== hero && x.slug !== 'search')].filter((x) => x !== undefined);
const stripFeatures = [...new Set(strip.map((x) => x.feature))];
const shotText = (slug: string, field: 'title' | 'alt', fallback: string) => {
  const v = t(`shots.${slug}.${field}`);
  return v.startsWith('shots.') ? fallback : v;
};
const reading = shotFor('reading');
const final = shot('inbox');
const shotUrls = screenshots.filter((s) => s.featured).map((s) => s.image.src);
const num = (n: number) => roughly(n).replace(/[\d,]+/, (d) => Number(d.replace(/,/g, '')).toLocaleString(lang));
// Where the magnifier rests, in % of the search screenshot: the typed
// expression, the filter chips, the first suggestion, then the rest of the line.
const heroPoints: [number, number][] = [
  [36, 8.6],
  [30, 14],
  [33, 19.4],
  [58, 8.6],
  [56, 14],
];
---

<Base
  lang={lang}
  isHome
  title={t('site.tagline')}
  description={t('site.description')}
  image={og}
  jsonLd={[softwareApplication(shotUrls), sourceCode()]}
>
  <section class="hero night">
    <div class="aurora" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="gridlines" aria-hidden="true"></div>
    <div class="wrap">
      <div class="hero-copy">
        <p class="eyebrow"><Icon name="sparkle" size={16} /> {t('home.eyebrow')}</p>
        <h1 set:html={t('home.h1_html')} />
        <p class="lead">{t('home.lead')}</p>
        <div class="cta">
          <a class="btn btn-primary" href={l('/download/')}>
            <Icon name="arrow-download" size={20} /> {t('common.downloadAndroid')}
          </a>
          <a class="btn" href={l('/features/')}>{t('home.seeWhat')} <Icon name="arrow-right" size={18} /></a>
        </div>
        <ul class="facts" aria-label={t('home.glance')}>
          <li><Icon name="checkmark" size={16} /> {t('home.fact1')}</li>
          <li><Icon name="checkmark" size={16} /> {t('home.fact2')}</li>
          <li><Icon name="checkmark" size={16} /> {t('home.fact3', { licence: site.licence.name })}</li>
        </ul>
      </div>
      <div class="showcase glass-panel" data-showcase>
        <div class="showcase-head">
          <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <div class="showcase-filters" role="group" aria-label={t('screenshots.filter')}>
            <button type="button" class="chip" aria-pressed="true" data-filter="all">{t('screenshots.all')}</button>
            {stripFeatures.map((f) => (
              <button type="button" class="chip" aria-pressed="false" data-filter={f}>{t(f === 'developer' ? 'shots.patch.title' : `screenshots.feature.${f}`)}</button>
            ))}
          </div>
          <div class="showcase-nav">
            <button type="button" class="icon-round prev" aria-label={t('screenshots.previous')} disabled><Icon name="arrow-left" size={18} /></button>
            <button type="button" class="icon-round next" aria-label={t('screenshots.next')}><Icon name="arrow-right" size={18} /></button>
          </div>
        </div>
        <ul class="showcase-track" tabindex="0" aria-label={t('screenshots.eyebrow')}>
          {strip.map((x, i) => (
            <li data-feature={x.feature}>
              {i === 0 ? (
                <Device
                  shot={x}
                  lens
                  points={heroPoints}
                  loading="eager"
                  sizes="(max-width: 600px) 220px, 260px"
                  placeholder={t('common.screenshotSoon')}
                  eggs={[t('egg.enhance1'), t('egg.enhance2'), t('egg.enhance3'), t('egg.enhanceReset')]}
                />
              ) : (
                <Device shot={x} loading={i < 4 ? 'eager' : 'lazy'} sizes="(max-width: 600px) 220px, 260px" />
              )}
              <p class="shot-title">{i === 0 ? t('home.lensHint') : shotText(x.slug, 'title', x.title)}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <a class="hero-ai" href="/private-ai/">
      <span class="soon">{soonLabel}</span>
      <span>Private AI: to-dos, plain-English search and rules, on your phone.</span>
      <Icon name="arrow-right" size={16} />
    </a>
  </section>

  <section class="providers-strip" aria-labelledby="providers-title">
    <h2 id="providers-title" class="providers-title">{t('home.providersTitle')}</h2>
    <div class="marquee">
      {[0, 1].map((copy) => (
        <ul aria-hidden={copy === 1 ? 'true' : undefined}>
          {providers.map((p) => <li class="chip">{p}</li>)}
          <li class="chip">{t('home.providerOwn')}</li>
        </ul>
      ))}
    </div>
    <p class="muted small" set:html={t('home.providersNote_html')} />
  </section>

  <section class="section pillars" aria-labelledby="pillars-title">
    <div class="wrap">
      <div class="section-head center">
        <p class="eyebrow">{t('home.pillarsEyebrow')}</p>
        <h2 id="pillars-title">{t('home.pillarsTitle')}</h2>
        <p class="lead">{t('home.pillarsLead')}</p>
      </div>
      <div class="pillar-grid">
        <article class="card pillar spot reveal">
          <div class="icon-tile lit"><Icon name="reading-mode-mobile" /></div>
          <h3>{t('home.calm')}</h3>
          <p>{t('home.calmText')}</p>
        </article>
        <article class="card pillar spot reveal">
          <div class="icon-tile lit"><Icon name="search-sparkle" /></div>
          <h3>{t('home.sharp')}</h3>
          <p>{t('home.sharpText')}</p>
        </article>
        <article class="card pillar spot reveal">
          <div class="icon-tile lit"><Icon name="shield-lock" /></div>
          <h3>{t('home.private')}</h3>
          <p>{t('home.privateText')}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section-tight why" aria-labelledby="why-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{t('home.whyEyebrow')}</p>
        <h2 id="why-title">{t('home.whyTitle')}</h2>
        <p class="lead">{t('home.whyLead')}</p>
      </div>
      <div class="compare-wrap">
        <table class="compare">
          <thead>
            <tr>
              <th scope="col"><span class="visually-hidden">{t('home.compareWhat')}</span></th>
              <th scope="col">{t('home.compareTypical')}</th>
              <th scope="col" class="us">{t('home.compareLoupe')}</th>
            </tr>
          </thead>
          <tbody>
            {['html', 'search', 'power', 'protocols', 'tracking', 'mailbox'].map((row) => (
              <tr>
                <th scope="row">{t(`home.cmp.${row}.label`)}</th>
                <td>{t(`home.cmp.${row}.typical`)}</td>
                <td class="us"><Icon name="checkmark" size={16} /> <span>{t(`home.cmp.${row}.loupe`)}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="muted compare-note">{t('home.compareNote')}</p>
      <div class="companion card">
        <div class="icon-tile"><Icon name="window-dev-tools" /></div>
        <div>
          <h3>{t('home.companionTitle')}</h3>
          <p>{t('home.companionText')}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section split search" aria-labelledby="search-title">
    <div class="wrap split-grid">
      <div>
        <p class="eyebrow">{t('home.searchEyebrow')}</p>
        <h2 id="search-title">{t('home.searchTitle')}</h2>
        <p class="lead">{t('home.searchLead')}</p>
        <p set:html={t('home.searchMore_html')} />
        <a class="btn btn-ghost" href="/docs/search-language/">{t('home.searchLanguage')} <Icon name="arrow-right" size={18} /></a>
      </div>
      <SearchPlayground lang={lang} />
    </div>
  </section>

  <section class="section split reading" aria-labelledby="reading-title">
    <div class="wrap split-grid reverse">
      <div class="device-col">
        <Device shot={reading} placeholder={t('common.screenshotSoon')} />
      </div>
      <div>
        <p class="eyebrow">{t('home.readingEyebrow')}</p>
        <h2 id="reading-title">{t('home.readingTitle')}</h2>
        <p class="lead">{t('home.readingLead')}</p>
        <ul class="ticks">
          <li><Icon name="checkmark" size={18} /> {t('home.readingTick1')}</li>
          <li><Icon name="checkmark" size={18} /> {t('home.readingTick2')}</li>
          <li><Icon name="checkmark" size={18} /> {t('home.readingTick3')}</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section features" aria-labelledby="features-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{t('home.featuresEyebrow')}</p>
        <h2 id="features-title">{t('home.featuresTitle')}</h2>
      </div>
      <div class="feature-grid">
        {
          highlights.map((f) => (
            <a class="feature spot reveal" href={f.docs}>
              <div class="icon-tile">
                <Icon name={f.icon} />
              </div>
              <h3>{t(`highlights.${f.key}.title`)}</h3>
              <p>{t(`highlights.${f.key}.text`)}</p>
            </a>
          ))
        }
      </div>
      <p class="more"><a class="btn" href={l('/features/')}>{t('home.tourAll')} <Icon name="arrow-right" size={18} /></a></p>
    </div>
  </section>

  <section class="ai night" aria-labelledby="ai-title">
    <div class="aurora" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="wrap">
      <div class="section-head center">
        <p class="eyebrow"><Icon name="sparkle" size={16} /> {aiIntro.eyebrow}</p>
        <h2 id="ai-title">An assistant that <span class="grad-text">never leaves your phone.</span></h2>
        <p class="lead">{aiIntro.lead}</p>
      </div>
      <AiDemo />
      <ul class="ai-principles">
        {aiPrinciples.map((p) => (
          <li><Icon name={p.icon} size={20} /><div><strong>{p.title}</strong><span>{p.text}</span></div></li>
        ))}
      </ul>
      <div class="ai-grid">
        {aiFeatures.map((f) => (
          <a class="ai-card spot reveal" href={`/private-ai/#${f.key}`}>
            <div class="icon-tile lit"><Icon name={f.icon} /></div>
            <h3>{f.title}</h3>
            <p>{f.short}</p>
          </a>
        ))}
      </div>
      <p class="more"><a class="btn" href="/private-ai/">{aiIntro.more} <Icon name="arrow-right" size={18} /></a></p>
    </div>
  </section>

  <section class="privacy" aria-labelledby="privacy-title">
    <div class="wrap privacy-grid">
      <div>
        <p class="eyebrow">{t('home.privacyEyebrow')}</p>
        <h2 id="privacy-title">{t('home.privacyTitle')}</h2>
        <p class="lead">{t('home.privacyLead')}</p>
        <a class="btn" href="/privacy/">{t('home.privacyRead')}</a>
      </div>
      <ul class="privacy-list">
        <li><Icon name="cloud-off" /><div><strong>{t('home.privacy1')}</strong><span>{t('home.privacy1Text')}</span></div></li>
        <li><Icon name="data-usage" /><div><strong>{t('home.privacy2')}</strong><span>{t('home.privacy2Text')}</span></div></li>
        <li><Icon name="lock-closed" /><div><strong>{t('home.privacy3')}</strong><span>{t('home.privacy3Text')}</span></div></li>
        <li><Icon name="eye-off" /><div><strong>{t('home.privacy4')}</strong><span>{t('home.privacy4Text')}</span></div></li>
      </ul>
    </div>
  </section>


  <section class="section open" aria-labelledby="open-title">
    <div class="wrap open-grid">
      <div>
        <p class="eyebrow">{t('home.openEyebrow')}</p>
        <h2 id="open-title">{t('home.openTitle')}</h2>
        <p class="lead">{t('home.openLead', { licence: site.licence.name })}</p>
        <div class="cta">
          <a class="btn" href="/development/">{t('home.howBuilt')}</a>
          <a class="btn btn-ghost" href={site.repo} rel="noopener">{t('home.sourceGithub')} <Icon name="open" size={18} /></a>
        </div>
      </div>
      <dl class="stats" data-count>
        <div><dt>{t('home.statTests')}</dt><dd>{num(stats.tests)}</dd></div>
        <div><dt>{t('home.statPackages')}</dt><dd>{stats.packages}</dd></div>
        {stats.commits && <div><dt>{t('home.statCommits')}</dt><dd>{num(stats.commits)}</dd></div>}
        <div><dt>{t('home.statTrackers')}</dt><dd>0</dd></div>
      </dl>
    </div>
  </section>

  <section class="section-tight final">
    <div class="wrap">
      <div class="final-card glow-border">
        {final && (
          <div class="final-device" aria-hidden="true">
            <Device shot={final} sizes="220px" />
          </div>
        )}
        <div class="final-copy">
          <h2>{t('home.finalTitle')}</h2>
          <p>{t('home.finalText')}</p>
          <div class="cta">
            <a class="btn btn-primary" href={l('/download/')}><Icon name="arrow-download" size={20} /> {t('common.downloadLoupe')}</a>
            <a class="btn" href={l('/screenshots/')}>{t('common.screenshots')}</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // The hero showcase: header chips filter the strip; arrows and the track scroll it sideways.
  for (const card of document.querySelectorAll<HTMLElement>('[data-showcase]')) {
    const track = card.querySelector<HTMLElement>('.showcase-track')!;
    const items = [...track.querySelectorAll<HTMLElement>('li')];
    const chips = [...card.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const prev = card.querySelector<HTMLButtonElement>('.prev')!;
    const next = card.querySelector<HTMLButtonElement>('.next')!;
    const smooth = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
    const update = () => {
      prev.disabled = track.scrollLeft <= 4;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
    };
    for (const chip of chips) {
      chip.addEventListener('click', () => {
        const f = chip.dataset.filter!;
        for (const c of chips) c.setAttribute('aria-pressed', String(c === chip));
        for (const item of items) item.hidden = f !== 'all' && item.dataset.feature !== f;
        track.scrollTo({ left: 0, behavior: smooth });
        chip.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: smooth });
        requestAnimationFrame(update);
      });
    }
    const page = (dir: number) => track.scrollBy({ left: dir * track.clientWidth * 0.8, behavior: smooth });
    prev.addEventListener('click', () => page(-1));
    next.addEventListener('click', () => page(1));
    track.addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    update();
  }

  // The stats count up when they scroll into view.
  const stats = document.querySelector<HTMLElement>('[data-count]');
  if (stats && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const cells = [...stats.querySelectorAll<HTMLElement>('dd')].map((dd) => {
      const text = dd.textContent ?? '';
      const m = text.match(/[\d.,\u00a0\u202f ]*\d/);
      return { dd, text, m, target: m ? Number(m[0].replace(/\D/g, '')) : 0 };
    });
    new IntersectionObserver((entries, obs) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      obs.disconnect();
      const start = performance.now();
      const tick = (now: number) => {
        const k = Math.min(1, (now - start) / 1400);
        const ease = 1 - Math.pow(1 - k, 3);
        for (const c of cells) {
          if (!c.m || !c.target) continue;
          c.dd.textContent = k < 1 ? c.text.replace(c.m[0], Math.round(c.target * ease).toLocaleString(document.documentElement.lang)) : c.text;
        }
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }, { threshold: 0.4 }).observe(stats);
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(48px, 8vw, 112px) clamp(40px, 6vw, 72px);
  }

  .hero-copy {
    display: grid;
    justify-items: center;
    max-width: 900px;
    margin-inline: auto;
    text-align: center;
  }

  .hero .cta,
  .hero .facts {
    justify-content: center;
  }

  .hero h1 {
    font-size: clamp(3rem, 8.4vw, 6.4rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.035em;
    margin-bottom: 28px;
  }

  .hero h1 :global(em) {
    display: inline-block;
    padding-right: 0.08em;
    font-style: italic;
    font-weight: 500;
    background: var(--grad-brand);
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 30px rgb(67 195 205 / 35%));
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero h1 :global(em) {
      animation: shimmer 6s ease-in-out infinite alternate;
    }
    .hero-copy > * {
      animation: rise 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }
    .hero-copy > :nth-child(2) { animation-delay: 0.08s; }
    .hero-copy > :nth-child(3) { animation-delay: 0.16s; }
    .hero-copy > :nth-child(4) { animation-delay: 0.24s; }
    .hero-copy > :nth-child(5) { animation-delay: 0.32s; }
    .showcase {
      animation: rise 1s cubic-bezier(0.2, 0.8, 0.2, 1) 0.3s both;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  @keyframes shimmer {
    to {
      background-position: 100% 0;
    }
  }

  .hero .eyebrow {
    padding: 6px 14px;
    border: 1px solid var(--glass-line);
    border-radius: 999px;
    background: var(--glass-bg);
    backdrop-filter: blur(8px);
  }

  .hero .lead {
    max-width: 34em;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 28px 0 0;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
    color: var(--night-ink-2);
    font-size: 0.9375rem;
  }

  .facts li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .facts :global(svg) {
    color: var(--night-ok);
  }

  /* The screenshot card: chips and arrows in its header, a sideways strip below. */
  .showcase {
    margin-top: clamp(40px, 6vw, 72px);
    border-radius: 28px;
    overflow: hidden;
  }

  .showcase-head {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 14px 12px 20px;
    border-bottom: 1px solid var(--glass-line);
    background: var(--night-surface);
  }

  .dots {
    display: flex;
    flex: none;
    gap: 7px;
  }

  .dots i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--night-ink) 18%, transparent);
  }

  .dots i:nth-child(1) {
    background: #43c3cd;
  }

  .showcase-filters {
    display: flex;
    flex: 1;
    gap: 8px;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
    mask-image: linear-gradient(90deg, #000 calc(100% - 32px), transparent);
    padding-right: 32px;
  }

  .showcase-filters::-webkit-scrollbar {
    display: none;
  }

  .showcase-filters .chip {
    flex: none;
    min-height: 34px;
    border-color: var(--glass-line);
    background: var(--glass-bg);
    color: var(--night-ink-2);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .showcase-filters .chip:hover {
    color: var(--night-ink);
    background: var(--night-hover);
  }

  .showcase-filters .chip[aria-pressed='true'] {
    border-color: transparent;
    background: var(--grad-brand);
    color: #fff;
  }

  .showcase-nav {
    display: flex;
    flex: none;
    gap: 6px;
  }

  .icon-round {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--glass-line);
    border-radius: 50%;
    background: var(--glass-bg);
    color: var(--night-ink);
    cursor: pointer;
    transition: background-color 0.2s ease, opacity 0.2s ease;
  }

  .icon-round:hover:not(:disabled) {
    background: var(--night-hover);
  }

  .icon-round:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .showcase-track {
    display: flex;
    gap: clamp(18px, 3vw, 32px);
    margin: 0;
    padding: clamp(24px, 4vw, 40px) clamp(20px, 4vw, 40px) 28px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: clamp(20px, 4vw, 40px);
    scrollbar-width: thin;
    scrollbar-color: var(--glass-line) transparent;
    list-style: none;
  }

  .showcase-track:focus-visible {
    outline-offset: -3px;
  }

  .showcase-track li {
    flex: none;
    width: clamp(190px, 22vw, 250px);
    scroll-snap-align: start;
  }

  .showcase-track li[hidden] {
    display: none;
  }

