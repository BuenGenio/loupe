---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { posts, formatDate, readingTime } from '../../lib/news';
import { blogPosting, breadcrumbs } from '../../lib/schema';
import { site } from '../../config';

export async function getStaticPaths() {
  return (await posts()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const path = `/news/${entry.id}/`;
const image = `/og/news/${entry.id}.jpg`;
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  image={image}
  type="article"
  published={entry.data.date}
  modified={entry.data.updated ?? entry.data.date}
  jsonLd={[
    blogPosting({ title: entry.data.title, description: entry.data.description, path, date: entry.data.date, updated: entry.data.updated, image }),
    breadcrumbs([
      { name: 'Home', path: '/' },
      { name: 'News', path: '/news/' },
      { name: entry.data.title, path },
    ]),
  ]}
>
  <article class="section-tight">
    <div class="wrap narrow">
      <a class="back" href="/news/"><Icon name="arrow-right" size={16} /> All news</a>
      <p class="meta">
        <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time> · {readingTime(entry.body)} min read · {site.owner.name}
      </p>
      <h1>{entry.data.title}</h1>
      <p class="standfirst">{entry.data.description}</p>
      <div class="prose">
        <Content />
      </div>
      <aside class="end card">
        <div>
          <h2>Try Loupe</h2>
          <p>Free and open source for Android. Pay what you want.</p>
        </div>
        <a class="btn btn-primary" href="/download/"><Icon name="arrow-download" size={20} /> Download</a>
      </aside>
    </div>
  </article>
</Base>

<style>
  .narrow {
    max-width: 780px;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 24px;
    color: var(--ink-3);
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .back :global(svg) {
    rotate: 180deg;
  }

  .meta {
    color: var(--ink-3);
    font-size: 0.9375rem;
  }

  h1 {
    font-size: clamp(2.3rem, 5.4vw, 3.6rem);
  }

  .standfirst {
    margin-bottom: 36px;
    color: var(--ink-2);
    font-size: 1.25rem;
    line-height: 1.5;
  }

  .prose {
    font-size: 1.125rem;
  }

  .end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 56px;
    padding: 24px 28px;
  }

  .end h2 {
    margin: 0 0 4px;
    font-size: 1.5rem;
  }

  .end p {
    margin: 0;
    color: var(--ink-2);
  }
</style>
