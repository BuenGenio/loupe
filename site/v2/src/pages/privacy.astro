---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { contact, donate, site } from '../config';
import { breadcrumbs } from '../lib/schema';

const policy = (await getEntry('legal', 'privacy-policy'))!;
const { Content } = await render(policy);
const updated = policy.data.updated.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

// The payment services the site actually links to (src/config.ts → donate).
const stripe = donate.tiers.some((t) => t.href) || Boolean(donate.custom.href);
const payments = [
  ...(stripe ? [{ name: 'Stripe', privacy: 'https://stripe.com/privacy' }] : []),
  ...donate.alternatives.filter((a) => a.href),
];
---

<Base
  title="Privacy policy"
  description="The Loupe app collects nothing: no analytics, telemetry or ads, and no servers of its own. What the app stores on your phone, who it talks to, and what this website records."
  image="/og/privacy.jpg"
  modified={policy.data.updated}
  jsonLd={[breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Privacy', path: '/privacy/' }])]}
>
  <section class="section-tight">
    <div class="wrap narrow">
      <p class="eyebrow">Privacy</p>
      <h1>Privacy policy</h1>
      <p class="muted">Last updated {updated}. The history of this policy is public in <a href={`${site.repo}/commits/main/docs/privacy-policy.md`}>the repository</a>.</p>
      <div class="prose">
        <Content />

        <h2 id="website">This website</h2>
        <ul>
          <li>
            {
              site.matomo.url ? (
                <>
                  <strong>No advertising.</strong> loupe.mx has no advertising scripts. It sets one cookie, and only
                </>
              ) : (
                <>
                  <strong>No tracking.</strong> loupe.mx has no advertising or tracking scripts. It sets one cookie, and only
                </>
              )
            }
            if you pick a language from the menu: <code>lang</code>, which remembers that choice for a year so the site
            doesn't switch you back to your browser's language. Your browser's language preference is used, without
            storing it, to send you to that language on your first visit.{
              site.analyticsToken
                ? ' It counts page views with Cloudflare Web Analytics, which uses no cookies and does not identify you.'
                : ''
            }
          </li>
          {
            site.matomo.url && (
              <li>
                <strong>Visit statistics.</strong> loupe.mx counts visits with Matomo, open-source analytics software, on
                the server <code>{new URL(site.matomo.url).host}</code>. It uses no cookies. For each page you open,
                Matomo receives the page address, the page that linked to it, your browser, operating system, screen
                size and language, and your IP address, from which it estimates your country. The statistics show which
                pages people read; they are not used for advertising.
              </li>
            )
          }
          <li>
            <strong>Hosting.</strong> The site is served by Cloudflare. Like any web host, Cloudflare processes your IP
            address to deliver pages and stop attacks; see
            <a href="https://www.cloudflare.com/privacypolicy/" rel="noopener">Cloudflare's privacy policy</a>.
          </li>
          <li>
            <strong>Downloads</strong> come from GitHub Releases, so GitHub sees the download request
            (<a href="https://docs.github.com/site-policy/privacy-policies/github-general-privacy-statement" rel="noopener">GitHub's privacy statement</a>).
          </li>
          {
            payments.length > 0 && (
              <li>
                <strong>Payments.</strong> If you choose to pay, {payments.length === 1 ? payments[0].name : 'the service you pick'}
                {' '}handles the payment on its own pages. Loupe receives what you enter there (usually your name, email
                address and the amount, and any message you add), never your card details
                ({payments.filter((p) => p.privacy).map((p, i) => (
                  <>
                    {i > 0 && ', '}
                    <a href={p.privacy} rel="noopener">{p.name}'s privacy policy</a>
                  </>
                ))}). It is used only for receipts and accounting.
              </li>
            )
          }
          <li>
            <strong>Mail you send us</strong> is used to answer you and is not shared. Write to
            <a href={`mailto:${contact.hello}`}>{contact.hello}</a> to have it deleted.
          </li>
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .narrow {
    max-width: 820px;
  }

  h1 {
    font-size: clamp(2.4rem, 5vw, 3.4rem);
  }
</style>
