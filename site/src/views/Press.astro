---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { contact, site } from '../config';
import { useT, localize } from '../i18n';
import { breadcrumbs } from '../lib/schema';
import { screenshots } from '../lib/screenshots';
import logo from '../assets/brand/logo.png';
import tile from '../assets/brand/icon-tile.png';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = useT(lang);
const l = (path: string) => localize(lang, path);
const colours = [
  { name: t('press.cTeal'), hex: '#0B7F8E' },
  { name: t('press.cSea'), hex: '#0F5F8A' },
  { name: t('press.cGlass'), hex: '#D4EBF8' },
  { name: t('press.cNavy'), hex: '#0C2238' },
];
const featured = screenshots.filter((s) => s.featured && s.device === 'phone').slice(0, 4);
const title = (slug: string, fallback: string) => {
  const v = t(`shots.${slug}.title`);
  return v.startsWith('shots.') ? fallback : v;
};
---

<Base
  lang={lang}
  title={t('press.title')}
  description={t('press.description')}
  image={lang === 'en' ? '/og/press.png' : `/og/${lang}/press.png`}
  jsonLd={[breadcrumbs([{ name: 'Loupe', path: l('/') }, { name: t('press.title'), path: l('/press/') }])]}
>
  <section class="top">
    <div class="wrap">
      <p class="eyebrow">{t('press.eyebrow')}</p>
      <h1>{t('press.h1')}</h1>
      <p class="lead">{t('press.lead')} <a href={`mailto:${contact.press}`}>{contact.press}</a>.</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap two">
      <div class="prose">
        <h2>{t('press.sentenceTitle')}</h2>
        <p>{t('press.sentence')}</p>
        <h2>{t('press.paragraphTitle')}</h2>
        <p>{t('press.paragraph', { licence: site.licence.name })}</p>
        <h2>{t('press.factsTitle')}</h2>
        <table>
          <tbody>
            <tr><th scope="row">{t('press.fName')}</th><td>{t('press.fNameValue')}</td></tr>
            <tr><th scope="row">{t('press.fPlatform')}</th><td>{t('press.fPlatformValue')}</td></tr>
            <tr><th scope="row">{t('press.fPrice')}</th><td>{t('press.fPriceValue')}</td></tr>
            <tr><th scope="row">{t('press.fLicence')}</th><td>{site.licence.name}</td></tr>
            <tr><th scope="row">{t('press.fProtocols')}</th><td>IMAP, SMTP, JMAP, ManageSieve</td></tr>
            <tr><th scope="row">{t('press.fBuilt')}</th><td>{t('press.fBuiltValue')}</td></tr>
            <tr><th scope="row">{t('press.fDeveloper')}</th><td><a href={site.owner.url}>{site.owner.name}</a></td></tr>
            <tr><th scope="row">{t('press.fWebsite')}</th><td><a href={site.url}>loupe.mx</a></td></tr>
            <tr><th scope="row">{t('press.fSource')}</th><td><a href={site.repo}>github.com/BuenGenio/loupe</a></td></tr>
          </tbody>
        </table>
        <h2>{t('press.pleaseTitle')}</h2>
        <ul>
          <li>{t('press.please1')}</li>
          <li>{t('press.please2')}</li>
          <li>{t('press.please3')}</li>
        </ul>
      </div>

      <div class="assets">
        <h2>{t('press.logoTitle')}</h2>
        <div class="logo-row">
          <a class="asset card" href={logo.src} download="loupe-logo.png">
            <span class="swatch light"><Image src={logo} alt={t('press.logoAlt')} width={180} /></span>
            <span class="label"><Icon name="arrow-download" size={16} /> {t('press.logoLabel')}</span>
          </a>
          <a class="asset card" href={tile.src} download="loupe-app-icon.png">
            <span class="swatch dark"><Image src={tile} alt={t('press.iconAlt')} width={150} /></span>
            <span class="label"><Icon name="arrow-download" size={16} /> {t('press.iconLabel')}</span>
          </a>
        </div>

        <h2>{t('press.coloursTitle')}</h2>
        <ul class="colours">
          {colours.map((c) => (
            <li>
              <span class="chipcolour" style={`background:${c.hex}`}></span>
              <span><strong>{c.name}</strong><code>{c.hex}</code></span>
            </li>
          ))}
        </ul>

        <h2>{t('press.typeTitle')}</h2>
        <p class="muted">{t('press.typeText')}</p>

        {featured.length > 0 && (
          <>
            <h2>{t('press.shotsTitle')}</h2>
            <div class="shots">
              {featured.map((s) => (
                <a href={s.image.src} download={`loupe-${s.slug}.png`} title={t('press.downloadShot', { title: title(s.slug, s.title) })}>
                  <Image src={s.image} alt={t(`shots.${s.slug}.alt`)} widths={[200, 400]} sizes="160px" />
                </a>
              ))}
            </div>
            <p class="muted small" set:html={t('press.shotsNote_html', { screenshots: l('/screenshots/') })} />
          </>
        )}
      </div>
    </div>
  </section>
</Base>

<style>
  .top {
    padding-block: clamp(48px, 7vw, 88px) 8px;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
  }

  .two {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(32px, 6vw, 72px);
  }

  .prose h2:first-child {
    margin-top: 0;
  }

  .assets h2 {
    margin: 32px 0 14px;
    font-size: 1.5rem;
  }

  .assets h2:first-child {
    margin-top: 0;
  }

  .logo-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .asset {
    display: grid;
    overflow: hidden;
    color: var(--ink);
    text-decoration: none;
  }

  .swatch {
    display: grid;
    place-items: center;
    height: 200px;
  }

  .swatch.light {
    background: #ffffff;
  }

  .swatch.dark {
    background: #e9eef3;
  }

  .label {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 12px 16px;
    border-top: 1px solid var(--line);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .colours {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .colours li {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .chipcolour {
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    border: 1px solid var(--line);
  }

  .colours strong {
    display: block;
    font-size: 0.9375rem;
  }

  .colours code {
    color: var(--ink-3);
    font-size: 0.8125rem;
  }

  .shots {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
  }

  .shots img {
    border-radius: 14px;
    border: 1px solid var(--line);
  }

  .small {
    font-size: 0.875rem;
  }

  @media (max-width: 900px) {
    .two {
      grid-template-columns: 1fr;
    }
  }
</style>
