---
// Types real Loupe search expressions, then shows how the app reads them as
// chips. The examples use the parser's actual syntax (packages/expr_search);
// the expressions stay as typed in every language, the chip labels translate.
import Icon from './Icon.astro';
import { useT } from '../i18n';

interface Props {
  lang: string;
}
const t = useT(Astro.props.lang);

type Chip = { field?: string; value?: string; op?: string };
const examples: { query: string; chips: Chip[]; note: string }[] = [
  {
    query: 'from:alice and (subject:invoice or body:"PO 123")',
    chips: [
      { field: t('searchDemo.from'), value: 'alice' },
      { op: `${t('searchDemo.and')} (` },
      { field: t('searchDemo.subject'), value: 'invoice' },
      { op: t('searchDemo.or') },
      { field: t('searchDemo.body'), value: '"PO 123"' },
      { op: ')' },
    ],
    note: t('searchDemo.note1'),
  },
  {
    query: 'is:unread and newer_than:7d and -tag:newsletter',
    chips: [
      { field: t('searchDemo.status'), value: t('searchDemo.unread') },
      { op: t('searchDemo.and') },
      { field: t('searchDemo.newerThan'), value: t('searchDemo.sevenDays') },
      { op: t('searchDemo.andNot') },
      { field: t('searchDemo.tag'), value: 'newsletter' },
    ],
    note: t('searchDemo.note2'),
  },
  {
    query: 'f:github.com s:"pull request" is:unreplied',
    chips: [
      { field: t('searchDemo.from'), value: 'github.com' },
      { field: t('searchDemo.subject'), value: '"pull request"' },
      { field: t('searchDemo.status'), value: t('searchDemo.unreplied') },
    ],
    note: t('searchDemo.note3'),
  },
];
---

<div class="search-demo" data-examples={JSON.stringify(examples.map((e) => e.query))}>
  <div class="bar" aria-hidden="true">
    <Icon name="search" size={20} />
    <code class="typed">{examples[0].query}</code><span class="caret"></span>
  </div>
  <div class="results">
    {
      examples.map((ex, i) => (
        <div class="example" data-index={i} hidden={i !== 0}>
          <p class="visually-hidden">{t('searchDemo.example', { q: ex.query })}</p>
          <ul class="chips" aria-label={t('searchDemo.readsAs')}>
            {ex.chips.map((c) =>
              c.op ? (
                <li class="op">{c.op}</li>
              ) : (
                <li class="chip">
                  <span class="f">{c.field}</span>
                  <span class="v">{c.value}</span>
                </li>
              ),
            )}
          </ul>
          <p class="note">{ex.note}</p>
        </div>
      ))
    }
  </div>
  <div class="stream" aria-hidden="true">
    <span class="dot local"></span> {t('searchDemo.local')}
    <span class="dot server"></span> {t('searchDemo.server')}
  </div>
</div>

<script>
  for (const demo of document.querySelectorAll<HTMLElement>('.search-demo')) {
    const queries: string[] = JSON.parse(demo.dataset.examples ?? '[]');
    const typed = demo.querySelector<HTMLElement>('.typed')!;
    const examples = demo.querySelectorAll<HTMLElement>('.example');
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) continue;

    let index = 0;
    const show = (i: number) => examples.forEach((el) => (el.hidden = Number(el.dataset.index) !== i));
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

    const run = async () => {
      for (;;) {
        const q = queries[index];
        demo.classList.add('typing');
        for (let n = 0; n <= q.length; n++) {
          typed.textContent = q.slice(0, n);
          await sleep(28 + Math.random() * 40);
        }
        demo.classList.remove('typing');
        show(index);
        await sleep(3800);
        index = (index + 1) % queries.length;
      }
    };

    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        io.disconnect();
        run();
      }
    });
    io.observe(demo);
  }
</script>

<style>
  .search-demo {
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--bg-elev);
    box-shadow: var(--shadow);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 12px 16px;
    border-radius: 14px;
    background: var(--bg-sunk);
    color: var(--ink-3);
    overflow: hidden;
  }

  .bar :global(svg) {
    flex: none;
  }

  .typed {
    overflow: hidden;
    color: var(--ink);
    font-size: clamp(0.8rem, 2.6vw, 0.98rem);
    white-space: nowrap;
    text-overflow: clip;
  }

  .caret {
    flex: none;
    width: 2px;
    height: 1.25em;
    margin-left: -6px;
    background: var(--brand);
    animation: blink 1s steps(1) infinite;
  }

  .typing .caret {
    animation: none;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .results {
    min-height: 108px;
    padding: 18px 4px 6px;
  }

  .example {
    animation: fade 0.45s ease both;
  }

  @keyframes fade {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0 0 12px;
    padding: 0;
    list-style: none;
  }

  .chip {
    padding: 0;
    overflow: hidden;
    border-color: color-mix(in srgb, var(--brand) 35%, var(--line));
  }

  .chip .f {
    padding: 4px 8px 4px 12px;
    background: var(--brand-soft);
    color: var(--brand-ink);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .chip .v {
    padding: 4px 12px 4px 8px;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .op {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .note {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .stream {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    color: var(--ink-3);
    font-size: 0.8125rem;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .dot.local {
    background: var(--ok);
  }

  .dot.server {
    margin-left: 8px;
    background: var(--brand-2);
    animation: pulse 1.6s ease-in-out infinite;
  }

  @keyframes pulse {
    50% {
      opacity: 0.3;
    }
  }
</style>
