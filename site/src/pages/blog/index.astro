---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { posts, formatDate, readingTime } from '../../lib/blog';
import { breadcrumbs } from '../../lib/schema';

const all = await posts();
---

<Base
  title="Blog"
  description="News from the Loupe project: releases, design notes, and how a private, open-source mail app for Android is built."
  image="/og/blog.jpg"
  jsonLd={[
    { '@type': 'Blog', name: 'Loupe blog', url: 'https://loupe.mx/blog/' },
    breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Blog', path: '/blog/' }]),
  ]}
>
  <section class="top">
    <div class="wrap">
      <p class="eyebrow">Blog</p>
      <h1>Notes from the workbench</h1>
      <p class="lead">Releases, design decisions and the occasional deep dive. <a href="/rss.xml">RSS feed</a></p>
    </div>
  </section>
  <section class="section-tight">
    <div class="wrap">
      {
        all.length === 0 ? (
          <p class="muted">The first post is on its way.</p>
        ) : (
          <ul class="posts">
            {all.map((p, i) => (
              <li class:list={['card', { lead: i === 0 }]}>
                <a href={`/blog/${p.id}/`}>
                  <span class="meta">
                    <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time> · {readingTime(p.body)} min read
                  </span>
                  <h2>{p.data.title}</h2>
                  <p>{p.data.description}</p>
                  <span class="more">
                    Read <Icon name="arrow-right" size={16} />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</Base>

<style>
  .top {
    padding-block: clamp(48px, 7vw, 88px) 8px;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
  }

  .posts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .posts .lead {
    grid-column: 1 / -1;
  }

  .posts a {
    display: block;
    padding: clamp(22px, 3vw, 32px);
    color: inherit;
    text-decoration: none;
  }

  .posts li:hover {
    border-color: var(--brand);
  }

  .meta {
    color: var(--ink-3);
    font-size: 0.875rem;
  }

  h2 {
    margin: 10px 0 8px;
    font-size: clamp(1.4rem, 2.6vw, 1.8rem);
  }

  .lead h2 {
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
  }

  .posts p {
    color: var(--ink-2);
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--brand-ink);
    font-weight: 500;
  }

  @media (max-width: 760px) {
    .posts {
      grid-template-columns: 1fr;
    }
  }
</style>
