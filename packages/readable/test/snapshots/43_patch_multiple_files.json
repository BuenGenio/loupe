        ]
      },
      {
        "type": "diff",
        "old": "drivers/frob/core.c",
        "new": "drivers/frob/core.c",
        "headers": [
          "diff --git a/drivers/frob/core.c b/drivers/frob/core.c",
          "index 3b18e51..a1d2c4f 100644"
        ],
        "hunks": [
          {
            "header": "@@ -10,7 +10,7 @@",
            "lines": [
              "10:10  #include <linux/spinlock.h>",
              "11:11  #include \"core.h\"",
              "12:12  ",
              "13: -static DEFINE_SPINLOCK(frob_lock);",
              ":13 +static DEFINE_SPINLOCK(frob_lock); /* writers only */",
              "14:14  ",
              "15:15  struct frob_ctx *frob_find(int id)",
              "16:16  {"
            ]
          },
          {
            "header": "@@ -42,13 +42,15 @@ int frob_read(struct frob_ctx *ctx, char *buf, size_t len)",
            "lines": [
              "42:42  {",
              "43:43         struct frob_entry *e;",
              "44:44  ",
              "45: -       spin_lock(&frob_lock);",
              "46: -       e = frob_lookup(ctx);",
              "47: -       spin_unlock(&frob_lock);",
              ":45 +       e = READ_ONCE(ctx->cached);",
              ":46 +       if (!e) {",
              ":47 +               e = frob_lookup(ctx);",
              ":48 +               WRITE_ONCE(ctx->cached, e);",
              ":49 +       }",
              "48:50         if (!e)",
              "49:51                 return -ENOENT;",
              "50: -       return frob_copy(e, buf, len);",
              ":52 +       return frob_copy(e, buf, min(len, e->size));",
              "51:53  }",
              "52:54  ",
              "53:55  EXPORT_SYMBOL_GPL(frob_read);"
            ]
          }
        ]
      },
