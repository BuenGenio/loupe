      {
        "type": "p",
        "inlines": [
          {
            "text": "The read path took frob_lock only to look the context up. Cache the\nlookup per context and read it with READ_ONCE(), so readers no longer\ncontend with writers."
          }
        ]
      },
      {
        "type": "p",
        "inlines": [
          {
            "text": "Reported-by: Carol Example <"
          },
          {
            "text": "carol@example.org",
            "u": true,
            "link": 1
          },
          {
            "text": ">\nSigned-off-by: Alice Example <"
          },
          {
            "text": "alice@example.org",
            "u": true,
            "link": 2
          },
          {
            "text": ">"
          }
        ]
      },
      {
        "type": "hr"
      },
      {
        "type": "p",
        "inlines": [
          {
            "text": "v2: use READ_ONCE() (Bob)"
          }
        ]
      },
      {
        "type": "diffstat",
        "summary": "2 files changed, 11 insertions(+), 6 deletions(-)",
        "files": [
          [
            "drivers/frob/core.c",
            14,
