<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- New-mail notifications (Android 13+ asks the user; Loupe asks after the first account is added).
         WorkManager (background sync) and flutter_local_notifications merge what else they need. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Instant Delivery (experimental, off by default): flutter_foreground_task's service of type specialUse.
         The plugin merges WAKE_LOCK and RECEIVE_BOOT_COMPLETED (to start again after a reboot). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- App Lock (off by default): local_auth_android merges USE_BIOMETRIC for the fingerprint or face prompt,
         which also offers the screen lock's PIN, pattern or password. -->

    <!-- App icon badge. app_badge_plus 1.3.5 merges launcher permissions for many vendors from its own
         manifest (plus a HOME-intent query to find the launcher). Kept: Samsung (provider READ/WRITE; One UI
         badges through a broadcast, the set upstream tests on Galaxy phones), Huawei and Honor (CHANGE_BADGE),
         Sony, HTC (UPDATE_SHORTCUT), Apex and Vivo. Xiaomi needs nothing: MIUI and HyperOS badge from
         notifications. The ones below have no use in that version and are dropped. -->
    <uses-permission android:name="com.majeur.launcher.permission.UPDATE_BADGE" tools:node="remove" />
    <uses-permission android:name="com.huawei.android.launcher.permission.READ_SETTINGS" tools:node="remove" />
    <uses-permission android:name="com.huawei.android.launcher.permission.WRITE_SETTINGS" tools:node="remove" />
    <uses-permission android:name="com.hihonor.android.launcher.permission.READ_SETTINGS" tools:node="remove" />
    <uses-permission android:name="com.hihonor.android.launcher.permission.WRITE_SETTINGS" tools:node="remove" />
    <uses-permission android:name="com.htc.launcher.permission.READ_SETTINGS" tools:node="remove" />
    <!-- Scanning Thunderbird's "Export for Mobile" QR codes (flutter_zxing on camera_android_camerax 0.7), asked
         for only when the scanner opens. The camera plugin also merges a microphone permission and old storage
         access for video recording, which Loupe never does: dropped. Phones without a camera can still install
         Loupe (the import takes pasted text too). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" tools:replace="android:required" />
    <!-- No backups and no phone-to-phone copies of Loupe's data (see res/xml/data_extraction_rules.xml):
         the database key lives in the Keystore, which doesn't move with them. -->
    <application
        android:label="Loupe"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="tiramisu">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- No android:taskAffinity="" (Flutter's template has it): with an empty affinity the browser's
                 OAuth redirect (Gmail, Microsoft) lands in a new task and never reaches flutter_appauth's
                 waiting activity (flutter_appauth README, "No Redirect to app after login"). -->
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- OAuth redirects (docs/oauth-setup.md). AppAuth's own filter takes the appAuthRedirectScheme placeholder
             (build.gradle.kts), Google's io.github.buengenio.loupe:/oauth2redirect. This one adds Microsoft's
             msauth.io.github.buengenio.loupe://auth: Entra only accepts custom schemes with "//", and this form is
             the one it generates for the bundle id. The manifest merger keeps both filters. -->
        <activity
            android:name="net.openid.appauth.RedirectUriReceiverActivity"
            android:exported="true"
            tools:node="merge">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="msauth.io.github.buengenio.loupe" android:host="auth" />
            </intent-filter>
        </activity>
        <!-- flutter_local_notifications: the Archive and Mark as Read buttons of new-mail notifications. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver" />
        <!-- Instant Delivery: keeps IMAP IDLE open on the inboxes while the user has switched it on.
             Warning: flutter_foreground_task needs this exact service name. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Instant email delivery: an optional, user-enabled mode that keeps an IMAP IDLE connection to the user's own mail server open, so new mail is notified within seconds instead of every 15 minutes. Standard IMAP servers offer no push service." />
        </service>
        <!-- The status bar icon of the Instant Delivery notification. -->
        <meta-data
            android:name="io.github.buengenio.loupe.NOTIFICATION_ICON"
            android:resource="@drawable/ic_stat_loupe" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- "Add to Calendar" on an invitation: the calendar app's new-event
             screen (Intent.ACTION_INSERT on CalendarContract.Events; no
             calendar permission), found through add_2_calendar. -->
        <intent>
            <action android:name="android.intent.action.INSERT"/>
            <data android:mimeType="vnd.android.cursor.item/event"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT"/>
            <data android:mimeType="vnd.android.cursor.dir/event"/>
        </intent>
        <!-- An invitation's "Map": the map app the user chose (geo: URIs). -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="geo"/>
        </intent>
    </queries>
</manifest>
