<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- New-mail notifications (Android 13+ asks the user; Loupe asks after the first account is added).
         WorkManager (background sync) and flutter_local_notifications merge what else they need. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Instant Delivery (experimental, off by default): flutter_foreground_task's service of type specialUse.
         The plugin merges WAKE_LOCK and RECEIVE_BOOT_COMPLETED (to start again after a reboot). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- App icon badge. app_badge_plus 1.3.5 merges launcher permissions for many vendors from its own
         manifest (plus a HOME-intent query to find the launcher). Kept: Samsung (provider READ/WRITE; One UI
         badges through a broadcast, the set upstream tests on Galaxy phones), Huawei and Honor (CHANGE_BADGE),
         Sony, HTC (UPDATE_SHORTCUT), Apex and Vivo. Xiaomi needs nothing: MIUI and HyperOS badge from
         notifications. The ones below have no use in that version and are dropped. -->
    <uses-permission android:name="com.majeur.launcher.permission.UPDATE_BADGE" tools:node="remove" />
    <uses-permission android:name="com.huawei.android.launcher.permission.READ_SETTINGS" tools:node="remove" />
    <uses-permission android:name="com.huawei.android.launcher.permission.WRITE_SETTINGS" tools:node="remove" />
    <uses-permission android:name="com.hihonor.android.launcher.permission.READ_SETTINGS" tools:node="remove" />
    <uses-permission android:name="com.hihonor.android.launcher.permission.WRITE_SETTINGS" tools:node="remove" />
    <uses-permission android:name="com.htc.launcher.permission.READ_SETTINGS" tools:node="remove" />
    <application
        android:label="Loupe"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- flutter_local_notifications: the Archive and Mark as Read buttons of new-mail notifications. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver" />
        <!-- Instant Delivery: keeps IMAP IDLE open on the inboxes while the user has switched it on.
             Warning: flutter_foreground_task needs this exact service name. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Instant email delivery: an optional, user-enabled mode that keeps an IMAP IDLE connection to the user's own mail server open, so new mail is notified within seconds instead of every 15 minutes. Standard IMAP servers offer no push service." />
        </service>
        <!-- The status bar icon of the Instant Delivery notification. -->
        <meta-data
            android:name="io.github.buengenio.loupe.NOTIFICATION_ICON"
            android:resource="@drawable/ic_stat_loupe" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
