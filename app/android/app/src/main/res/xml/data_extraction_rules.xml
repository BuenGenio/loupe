<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of Loupe's goes into a cloud backup or onto a new phone (Android 12+; older versions follow
     android:allowBackup="false"). The mail database is encrypted with a key kept in the Android Keystore,
     which neither carries: a restored copy can't be opened, and its settings would point at accounts
     that aren't there. Mail stays on the servers; on a new phone the accounts are added again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
